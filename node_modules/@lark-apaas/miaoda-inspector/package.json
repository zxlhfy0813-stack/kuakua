{
  "name": "@lark-apaas/miaoda-inspector",
  "version": "1.0.24",
  "description": "Inspector for Lark Apaas",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/lib/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.mjs",
      "require": "./dist/lib/index.js"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json",
    "check-type": "rush check-type",
    "lint": "eslint . --quiet",
    "start": "rush storybook",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "test:update": "vitest run -u",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm test && pnpm test:e2e",
    "dev:test": "vite --config vite.test.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@zumer/snapdom": "^1.9.14",
    "clsx": "~2.0.0",
    "colorjs.io": "^0.5.2",
    "hotkeys-js": "^3.8.1",
    "react-dev-utils": "12.0.1",
    "tailwind-merge": "~2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/react": "^12",
    "@testing-library/react-hooks": "^8",
    "@types/node": "^18.17.18",
    "@types/react": "^17",
    "@types/react-reconciler": ">=0.26.6",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^8",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^4",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  }
}
