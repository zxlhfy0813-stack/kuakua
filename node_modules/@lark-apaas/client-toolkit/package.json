{
  "name": "@lark-apaas/client-toolkit",
  "version": "1.2.64",
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./runtime": {
      "import": "./lib/runtime/index.js",
      "require": "./lib/runtime/index.js",
      "types": "./lib/runtime/index.d.ts"
    },
    "./antd-table": {
      "import": "./lib/antd-table.js",
      "require": "./lib/antd-table.js",
      "types": "./lib/antd-table.d.ts"
    },
    "./lib/index.css": "./lib/index.css",
    "./styles.css": "./lib/index.css",
    "./dataloom": {
      "import": "./lib/apis/dataloom.js",
      "require": "./lib/apis/dataloom.js",
      "types": "./lib/apis/dataloom.d.ts"
    },
    "./logger": {
      "import": "./lib/apis/logger.js",
      "require": "./lib/apis/logger.js",
      "types": "./lib/apis/logger.d.ts"
    },
    "./trace": {
      "import": "./lib/apis/trace.js",
      "require": "./lib/apis/trace.js",
      "types": "./lib/apis/trace.d.ts"
    },
    "./udt-types": {
      "import": "./lib/apis/udt-types.js",
      "require": "./lib/apis/udt-types.js",
      "types": "./lib/apis/udt-types.d.ts"
    },
    "./components/*": {
      "import": "./lib/apis/components/*.js",
      "require": "./lib/apis/components/*.js",
      "types": "./lib/apis/components/*.d.ts"
    },
    "./constants/*": {
      "import": "./lib/apis/constants/**/*.js",
      "require": "./lib/apis/constants/**/*.js",
      "types": "./lib/apis/constants/**/*.d.ts"
    },
    "./hooks/*": {
      "import": "./lib/apis/hooks/*.js",
      "require": "./lib/apis/hooks/*.js",
      "types": "./lib/apis/hooks/*.d.ts"
    },
    "./tools/*": {
      "import": "./lib/apis/tools/*.js",
      "require": "./lib/apis/tools/*.js",
      "types": "./lib/apis/tools/*.d.ts"
    },
    "./utils/*": {
      "import": "./lib/apis/utils/*.js",
      "require": "./lib/apis/utils/*.js",
      "types": "./lib/apis/utils/*.d.ts"
    },
    "./aily-chat": {
      "import": "./lib/apis/aily-chat.js",
      "require": "./lib/apis/aily-chat.js",
      "types": "./lib/apis/aily-chat.d.ts"
    },
    "./auth": {
      "import": "./lib/auth.js",
      "require": "./lib/auth.js",
      "types": "./lib/auth.d.ts"
    }
  },
  "scripts": {
    "tsc": "tsc --declaration",
    "build": "rslib build",
    "build:storybook": "storybook build",
    "check": "biome check --write",
    "dev": "rslib build --watch",
    "format": "biome format --write",
    "storybook": "storybook dev",
    "test": "vitest",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "prepublishOnly": "npm run build && node scripts/replace-workspace-alias.js"
  },
  "dependencies": {
    "@ant-design/colors": "^7.2.1",
    "@ant-design/cssinjs": "^1.24.0",
    "@lark-apaas/aily-web-sdk": "^0.0.12",
    "@lark-apaas/auth-sdk": "^0.1.5",
    "@lark-apaas/client-capability": "^0.1.7",
    "@lark-apaas/dataloom": "^0.1.4",
    "@lark-apaas/internal-slardar": "^0.0.3",
    "@lark-apaas/miaoda-inspector": "^1.0.24",
    "@lark-apaas/observable-web": "^1.0.6",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@zumer/snapdom": "^1.9.14",
    "axios": "^1.12.2",
    "blueimp-md5": "2.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "~2.0.1",
    "crypto-js": "3.1.9-1",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "lodash": "^4.17.21",
    "network-idle": "^0.2.0",
    "penpal": "^6.2.2",
    "sonner": "~2.0.0",
    "source-map": "^0.7.6",
    "stacktrace-js": "^2.0.2",
    "tailwind-merge": "~2.0.0",
    "tailwind-variants": "0.3.1",
    "tailwindcss-animate": "^1.0.7",
    "url": "^0.11.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@rsbuild/core": "~1.4.13",
    "@rsbuild/plugin-react": "^1.3.4",
    "@rslib/core": "^0.15.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/blueimp-md5": "^2.18.2",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "antd": "^5.26.6",
    "eslint": "^8.57.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.554.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "storybook": "^8.6.14",
    "storybook-addon-rslib": "^1.0.2",
    "storybook-react-rsbuild": "^1.0.2",
    "tailwindcss": "^4.1.13",
    "tsc-watch": "^7.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.12",
    "antd": ">=5.26.6",
    "react": ">=16.14.0",
    "react-dom": ">=16.14.0",
    "react-router-dom": ">=6.26.2",
    "styled-jsx": ">=5.0.0"
  }
}
